#!/bin/sh
# Installed by `npm install` (sets core.hooksPath to .githooks).
# Skip once with: git commit --no-verify

files=$(git diff --cached --name-only --diff-filter=ACMR)
[ -z "$files" ] && exit 0

if ! echo "$files" | tr '\n' '\0' | xargs -0 npx --no-install prettier --check --ignore-unknown; then
  echo ""
  echo "Formatting issues found. Run: npm run format  (then git add the files)"
  exit 1
fi

sh scripts/check-index.sh || { echo "Update the Index table in README.md."; exit 1; }
